# Variable names only. Never put secrets or credentials in this file.
# (The source spreadsheet ID/worksheet name below are non-secret identifiers; access is controlled by Google permissions.)
# Copy to .env locally (git-ignored). Production values come from Secret Manager / Cloud Run env.

# Runtime
APP_ENV=local                      # local | pilot | production
APP_TIMEZONE=Asia/Kolkata
DRY_RUN=true                       # true = never call Gmail send
RECIPIENT_ALLOWLIST=               # comma-separated; when set, only these addresses may receive mail
TARGET_DATE=                       # optional manual override YYYY-MM-DD (must be before today, Asia/Kolkata); empty = yesterday

# Anthropic (model IDs intentionally blank until confirmed — OD-12)
ANTHROPIC_API_KEY=
MODEL_ANALYSIS=
MODEL_SUMMARY=
MODEL_GENERATION=
MODEL_VALIDATION=

# Google Sheets (verified source — docs/source-sheet-profile.md; tracking location OD-18)
SOURCE_SPREADSHEET_ID=1jRNPM4GJ4ctV5lgUVzyJhhq15tFdnT3jZ5TjHsAPbsI
SOURCE_WORKSHEET_NAME=Calls DONE
TRACKING_SPREADSHEET_ID=
TRACKING_WORKSHEET_NAME=POST_CALL_EMAIL_LOGS
EVENTS_WORKSHEET_NAME=POST_CALL_EMAIL_EVENTS

# Gmail (OD-06, OD-07)
GMAIL_SENDER_ADDRESS=
GMAIL_SENDER_DISPLAY_NAME=
GMAIL_REPLY_TO=
MESSAGE_ID_DOMAIN=

# Google auth (path only; file itself is git-ignored and never stored in OneDrive)
GOOGLE_APPLICATION_CREDENTIALS=
